# ============================================================
# SafeRoute — Environment Configuration Example
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git. Only .env.example is committed.
# ============================================================

# ------------------------------------------------------------
# SUPABASE (anon/public key ONLY — never the service role key)
# ------------------------------------------------------------
SUPABASE_URL=https:https://usexaanovsmmzjorlkyu.supabase.co
SUPABASE_ANON_KEY=sb_publishable_Bv8JT2ZGmqyvtPiuK_N6WQ_OvxzAWI6
# The service role key lives ONLY in Supabase Edge Function secrets.
# Never put it here or anywhere in the Flutter codebase.

# ------------------------------------------------------------
# FCM (Firebase Cloud Messaging) — client-side config only
# The FCM server key lives ONLY in Supabase Edge Function secrets.
# ------------------------------------------------------------
FCM_VAPID_KEY=your_fcm_vapid_key_here
GOOGLE_SERVICES_JSON_PATH=android/app/google-services.json
GOOGLE_SERVICES_PLIST_PATH=ios/Runner/GoogleService-Info.plist

# ------------------------------------------------------------
# MAP TILES (OpenStreetMap-compatible, no Google Maps)
# ------------------------------------------------------------
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILE_ATTRIBUTION=© OpenStreetMap contributors
# Optionally override with a tile provider that allows caching
# MAP_TILE_URL=https://tiles.stadiamaps.com/tiles/alidade_smooth/{z}/{x}/{y}.png
# MAP_MAX_ZOOM=19
# MAP_MIN_ZOOM=5

# ------------------------------------------------------------
# GPS TRACKING INTERVALS (milliseconds)
# These are starting defaults — adaptive engine adjusts dynamically.
# ------------------------------------------------------------
GPS_INTERVAL_STOPPED_MS=45000
GPS_INTERVAL_SLOW_MS=15000
GPS_INTERVAL_NORMAL_MS=10000
GPS_INTERVAL_FAST_MS=7000
GPS_INTERVAL_APPROACHING_MS=3000

# Distance threshold to upload a GPS update (meters)
GPS_UPLOAD_MIN_DISTANCE_M=10

# Maximum time between uploads even if no movement (milliseconds)
GPS_UPLOAD_MAX_INTERVAL_MS=60000

# Maximum speed in km/h — above this a point is considered invalid
GPS_MAX_SPEED_KMH=150

# Accuracy threshold — ignore fixes worse than this (meters)
GPS_MIN_ACCURACY_M=50

# ------------------------------------------------------------
# PROXIMITY DETECTION
# ------------------------------------------------------------
# Buffer zone before notification threshold (meters)
PROXIMITY_APPROACHING_BUFFER_M=200

# Accuracy required before transitioning to NOTIFIED (meters)
PROXIMITY_MIN_ACCURACY_FOR_NOTIFY_M=100

# ------------------------------------------------------------
# NOTIFICATION RETRY
# ------------------------------------------------------------
NOTIFICATION_MAX_RETRY_ATTEMPTS=5
NOTIFICATION_RETRY_BACKOFF_BASE_SECONDS=30

# ------------------------------------------------------------
# STALE TRIP DETECTION
# ------------------------------------------------------------
# Mark trip STALE if no GPS update for this many seconds
STALE_TRIP_TIMEOUT_SECONDS=300

# ------------------------------------------------------------
# OFFLINE QUEUE
# ------------------------------------------------------------
# Max GPS points to buffer locally when offline
OFFLINE_QUEUE_MAX_SIZE=200

# ------------------------------------------------------------
# DATA RETENTION DEFAULTS (days)
# These mirror the database defaults. Org admins can override.
# ------------------------------------------------------------
RETENTION_GPS_HISTORY_DAYS=30
RETENTION_NOTIFICATION_LOG_DAYS=90
RETENTION_EMERGENCY_ALERT_DAYS=180
RETENTION_TRIP_HISTORY_DAYS=365
RETENTION_DEVICE_TOKEN_DAYS=60
RETENTION_AUDIT_LOG_DAYS=365

# ------------------------------------------------------------
# FEATURE FLAGS
# ------------------------------------------------------------
FEATURE_MAGIC_LINK_ENABLED=true
FEATURE_WHATSAPP_ENABLED=true
FEATURE_SMS_ENABLED=true
FEATURE_ADMIN_LIVE_MAP_ENABLED=true
FEATURE_BATTERY_REPORTING_ENABLED=true
